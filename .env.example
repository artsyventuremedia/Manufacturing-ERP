# core-api / core-worker (see apps/core/src/config/config.ts for all options)
NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://manuling_app:manuling_app@localhost:5432/manuling
OIDC_ISSUER=http://localhost:8080/realms/manuling
OIDC_AUDIENCE=manuling-api
# TENANT_BASE_DOMAIN=manuling.localhost
LOG_LEVEL=info
LOG_PRETTY=true
DEFAULT_LOCALE=en-IN
DEFAULT_TIMEZONE=Asia/Kolkata

# events (core-worker): kafka with the dev stack, memory without Docker
EVENT_BUS=kafka
KAFKA_BROKERS=localhost:9092
DATABASE_RELAY_URL=postgres://manuling_relay:manuling_relay@localhost:5432/manuling

# migrations (owner role)
DATABASE_ADMIN_URL=postgres://postgres:postgres@localhost:5432/manuling
APP_DB_USER=manuling_app
RELAY_DB_USER=manuling_relay
