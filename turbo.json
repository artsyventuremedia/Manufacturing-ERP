{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "stream",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "outputs": []
    },
    "lint": {
      "outputs": []
    },
    "test": {
      "outputs": []
    },
    "test:integration": {
      "outputs": [],
      "cache": false,
      "passThroughEnv": ["KAFKA_TEST_BROKERS", "MANULING_TEST_DATABASE_URL", "TEST_LOG_LEVEL"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
