{
  "$id": "urn:manuling:event:platform.RoleFieldPoliciesReplaced.v1",
  "title": "platform.RoleFieldPoliciesReplaced.v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "roleId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "policies": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "entity": {
            "type": "string"
          },
          "field": {
            "type": "string"
          },
          "access": {
            "type": "string",
            "enum": [
              "hidden",
              "read"
            ]
          }
        },
        "required": [
          "entity",
          "field",
          "access"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "roleId",
    "policies"
  ],
  "additionalProperties": false
}
