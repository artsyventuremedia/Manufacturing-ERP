{
  "name": "@manuling/platform",
  "version": "0.0.0",
  "private": true,
  "description": "Platform bounded context: tenancy, organisation structure, identity, idempotency (Phase 0).",
  "type": "module",
  "exports": {
    "./contracts": {
      "@manuling/source": "./src/contracts/index.ts",
      "types": "./dist/contracts/index.d.ts",
      "default": "./dist/contracts/index.js"
    },
    "./module": {
      "@manuling/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "migrations"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "dependencies": {
    "@manuling/authz": "workspace:*",
    "@manuling/db": "workspace:*",
    "@manuling/events": "workspace:*",
    "@manuling/http": "workspace:*",
    "@manuling/kernel": "workspace:*",
    "@nestjs/common": "^12.1.0",
    "@nestjs/core": "^12.1.0",
    "@temporalio/activity": "1.24.0",
    "@temporalio/client": "1.24.0",
    "@temporalio/worker": "1.24.0",
    "@temporalio/workflow": "1.24.0",
    "drizzle-orm": "^0.45.3",
    "fastify": "^5.12.5",
    "jose": "^6.2.12",
    "pg": "^8.23.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@manuling/testing": "workspace:*",
    "@swc/core": "^1.16.2",
    "@temporalio/testing": "1.24.0",
    "@types/pg": "^8.23.1",
    "unplugin-swc": "^2.0.0"
  }
}
